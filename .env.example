# 이 파일을 복사해 .env.local 로 이름을 바꾼 뒤 값을 채웁니다. (.env.local 은 GitHub에 올라가지 않습니다)
# Vercel 에서는 Project Settings > Environment Variables 에 같은 이름으로 넣습니다.

# 공공데이터포털에서 발급받은 인증키 2개
JEJU_CULTURE_INFO_KEY=
JEJU_CULTURE_LOCATION_KEY=

# 각 API의 요청 주소 (키를 뺀 '?' 앞부분). 공공데이터포털 마이페이지 > 개발계정 > 상세보기(Swagger)에서 확인
JEJU_CULTURE_INFO_URL=
JEJU_CULTURE_LOCATION_URL=
